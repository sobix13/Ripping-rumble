# Local credentials. Never commit a populated environment file.
DISCORD_TOKEN=
DEV_GUILD_ID=
# Optional loopback health port (default8093).
HEALTH_PORT=8093
# Local development overrides. Managed systemd runs use shared runtime paths.
# DB_PATH=/path/to/private/rumble.sqlite3
# LOG_DIR=/path/to/private/logs
# RUMBLE_BACKUP_DIR=/path/to/private/backups
# RUMBLE_HEALTH_FILE=/path/to/private/data/health.json
# LOG_LEVEL=INFO
