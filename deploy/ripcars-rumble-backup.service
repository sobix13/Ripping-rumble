[Unit]
Description=Verified RipCars Rumble SQLite backup
After=ripcars-rumble.service

[Service]
Type=oneshot
User=rumble
Group=rumble
WorkingDirectory=/opt/ripcars-rumble/current
ExecStart=/opt/ripcars-rumble/current/.venv/bin/python -m rumble.maintenance backup --db /opt/ripcars-rumble/shared/data/rumble.sqlite3 --directory /opt/ripcars-rumble/shared/backups --keep 14
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ripcars-rumble/shared/backups /opt/ripcars-rumble/shared/data
